{
  "name": "vmo-request",
  "version": "0.0.3",
  "type": "module",
  "private": false,
  "description": "axios request http https",
  "main": "./dist/vmo-request.umd.cjs",
  "module": "./dist/vmo-request.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vmo-request.js",
      "require": "./dist/vmo-request.umd.cjs"
    },
    "./*": "./*"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "coverage": "vitest run --coverage",
    "test": "vitest",
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "axios": "^1.7.8",
    "md5": "^2.3.0",
    "ramda": "^0.30.0"
  },
  "devDependencies": {
    "@types/md5": "^2.3.5",
    "@types/node": "^20.10.4",
    "@types/ramda": "^0.30.2",
    "@vitejs/plugin-vue": "^4.5.0",
    "@vitest/coverage-v8": "^2.1.5",
    "autoprefixer": "^10.4.16",
    "axios-mock-adapter": "^2.1.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.32",
    "rollup-plugin-ignore": "^1.0.10",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.2.2",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^3.6.4",
    "vitest": "^2.1.5",
    "vue-tsc": "^1.8.22"
  }
}
